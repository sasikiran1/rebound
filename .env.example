# Copy to .env (gitignored). The Makefile and the scripts in scripts/ read it.

# Meta Model API key. Needed only for runs that call Muse Spark (the live screen with MODEL=muse-spark-1.3, the
# Muse evaluation and demo scripts). The recovery checks and the form arm need no key. Never commit the real value.
MODEL_API_KEY=

# Everything below is optional; the values shown are the defaults.
# REBOUND_PG_HOST=127.0.0.1
# REBOUND_PG_PORT=55432
# REBOUND_FIELDDESK_URL=http://127.0.0.1:8080
# REBOUND_TOXIPROXY_URL=http://127.0.0.1:8474
# FIELDDESK_DB=fielddesk_trial

# Resolve service (resolve/app.py): model, per-process spending caps, confirm-before-booking.
# RESOLVE_MODEL=muse-spark-1.3
# RESOLVE_MAX_CALLS=50
# RESOLVE_MAX_COST=1.00
# RESOLVE_CONFIRM=true

# Technicians' calendars (CalDAV) and customer email (SMTP). The compose `resolve` profile provides local servers.
# RESOLVE_CALDAV_URL=http://127.0.0.1:5232/fielddesk/
# RESOLVE_CALDAV_USER=fielddesk
# RESOLVE_CALDAV_PASSWORD=local-only
# RESOLVE_SMTP_HOST=127.0.0.1
# RESOLVE_SMTP_PORT=1025
